# Optional. When set, the $195 button is a real Stripe Payment Link.
# The amount charged is whatever that Payment Link is set to in Stripe.
# When unset, the button reads: Payment not connected yet
STRIPE_PAYMENT_LINK_URL=

# Optional. $397 Listing Rebuild on the thank-you page only.
STRIPE_REBUILD_PAYMENT_LINK_URL=

MAPGAP_PORT=8787
MAPGAP_HOST=0.0.0.0

# Optional. Off when unset. When set to a hostname, every request on any
# other host 301s to https://<CANONICAL_HOST><path>?<query>. /health is exempt.
# Leave this unset until shopvsshop.com DNS is live. Do not set it in render.yaml.
# CANONICAL_HOST=shopvsshop.com

# Google Places API (New). Off unless BOTH are set. Leave unset to keep Nominatim.
# USE_GOOGLE_PLACES=true
# GOOGLE_PLACES_API_KEY=
# Optional. Max Places HTTP calls per UTC day. Default 30.
# PLACES_DAILY_CAP=30
